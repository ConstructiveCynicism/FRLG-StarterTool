<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="FlashCap" Version="1.12.0" />
    <PackageReference Include="Sdcb.FFmpeg" Version="7.0.0" />
    <PackageReference Include="Sdcb.FFmpeg.runtime.windows-x64" Version="7.1.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <ProjectReference Include="..\FRLG.StarterTool.Core\FRLG.StarterTool.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FRLGStarterTool</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <Target Name="DropUnusedFFmpegLibraries" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(avdevice|avfilter|postproc)-'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(avdevice|avfilter|postproc)-'))" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <VoskModelUrl>https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip</VoskModelUrl>
    <VoskModelSha256>30F26242C4EB449F948E42CB302DD7A686CB29A3423A8367F99FF41780942498</VoskModelSha256>
    <VoskModelDir>$(MSBuildProjectDirectory)\obj\vosk</VoskModelDir>
    <VoskModelZip>$(VoskModelDir)\vosk-model-small-en-us-0.15.zip</VoskModelZip>
    <VoskModelPartial>$(VoskModelDir)\download.partial</VoskModelPartial>
  </PropertyGroup>

  <Target Name="FetchVoskModel" BeforeTargets="PrepareForBuild" Condition="!Exists('$(VoskModelZip)')">
    <Delete Files="$(VoskModelPartial)" />
    <DownloadFile SourceUrl="$(VoskModelUrl)" DestinationFolder="$(VoskModelDir)"
                  DestinationFileName="download.partial" ContinueOnError="WarnAndContinue" />
    <GetFileHash Condition="Exists('$(VoskModelPartial)')" Files="$(VoskModelPartial)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="VoskModelActualSha256" />
    </GetFileHash>
    <Move Condition="Exists('$(VoskModelPartial)') And '$(VoskModelActualSha256)' == '$(VoskModelSha256)'"
          SourceFiles="$(VoskModelPartial)" DestinationFiles="$(VoskModelZip)" />
    <Warning Condition="Exists('$(VoskModelPartial)')"
             Text="The downloaded Vosk model does not match its pinned hash and was discarded; this build has no speech model." />
    <Delete Files="$(VoskModelPartial)" />
  </Target>

  <Target Name="EmbedVoskModel" BeforeTargets="PrepareForBuild" DependsOnTargets="FetchVoskModel">
    <ItemGroup Condition="Exists('$(VoskModelZip)')">
      <EmbeddedResource Include="$(VoskModelZip)" LogicalName="vosk-model.zip" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <Product>FRLG Starter Tool</Product>
    <AssemblyTitle>FRLG Starter Tool</AssemblyTitle>
    <Description>Gen 3 starter RNG prediction with a variable offset timer and global hotkeys, for Pokemon FireRed/LeafGreen.</Description>
    <Copyright>Copyright (c) 2026 ConstructiveCynicism</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" />
    <EmbeddedResource Include="Resources\pokemon\*.png" />
    <EmbeddedResource Include="Resources\beeps\*.wav" />
    <EmbeddedResource Include="Resources\npc\*.png" />
    <EmbeddedResource Include="Resources\npc\*.widths" />
  </ItemGroup>

</Project>
